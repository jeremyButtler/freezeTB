CC=cl.exe
LD=link.exe
CFLAGS= /c /O2 /Ot /Za /Tc
O=o.win
PREFIX=%appData%\local\bin

objFiles= \
   closestSpol.$(O) \
	..\genFreezeTB\findCloseBarcodes.$(O) \
   ..\genFreezeTB\spolST.$(O) \
   ..\genLib\ulCp.$(O) \
   ..\genLib\charCp.$(O) \
   ..\genLib\numToStr.$(O) \
   ..\genLib\base10str.$(O) \
   ..\genLib\fileFun.$(O)

all: closestSpol.$(O)
	$(LD) /out:closestSpol $(objFiles)

closestSpol.$(O): \
	closestSpol.c \
	..\genFreezeTB\findCloseBarcodes.$(O) \
	..\genLib\base10str.$(O)
		$(CC) /Fo:closestSpol.$(O) $(CFLAGS) closestSpol.c

..\genFreezeTB\findCloseBarcodes.$(O): \
	..\genFreezeTB\findCloseBarcodes.c \
	..\genFreezeTB\findCloseBarcodes.h \
	..\genFreezeTB\spolST.$(O)
		$(CC) \Fo:..\genFreezeTB\findCloseBarcodes.$(O) \
			$(CFLAGS) ..\genFreezeTB\findCloseBarcodes.c

..\genFreezeTB\spolST.$(O): \
	..\genFreezeTB\spolST.c \
	..\genFreezeTB\spolST.h \
	..\genLib\charCp.$(O) \
	..\genLib\numToStr.$(O) \
	..\genLib\fileFun.$(O) \
	..\genLib\genMath.h \
	..\genLib\64bit.h \
	..\genFreezeTB\tbSpolDefs.h
		$(CC) /Fo:..\genFreezeTB\spolST.$(O) $(CFLAGS) ..\genFreezeTB\spolST.c

..\genLib\fileFun.$(O): \
	..\genLib\fileFun.c \
	..\genLib\fileFun.h \
	..\genLib\ulCp.$(O) \
	..\genLib\endLine.h
		$(CC) /Fo:..\genLib\fileFun.$(O) $(CFLAGS) ..\genLib\fileFun.c

..\genLib\ulCp.$(O): ..\genLib\ulCp.c ..\genLib\ulCp.h
		$(CC) /Fo:..\genLib\ulCp.$(O) $(CFLAGS) ..\genLib\ulCp.c

..\genLib\charCp.$(O): ..\genLib\charCp.c ..\genLib\charCp.h
		$(CC) /Fo:..\genLib\charCp.$(O) $(CFLAGS) ..\genLib\charCp.c

..\genLib\numToStr.$(O): ..\genLib\numToStr.c ..\genLib\numToStr.h
		$(CC) /Fo:..\genLib\numToStr.$(O) $(CFLAGS) ..\genLib\numToStr.c

..\genLib\base10str.$(O): ..\genLib\base10str.c ..\genLib\base10str.h
		$(CC) /Fo:..\genLib/base10str.$(O) $(CFLAGS) ..\genLib\base10str.c

install:
	move closestSpol $(PREFIX)
clean:
	del $(objFiles)
