</$objtype/mkfile
CFLAGS=-DPLAN9
PREFIX=$home/bin

objFiles= \
   closestSpol.$O \
	../genFreezeTB/findCloseBarcodes.$O \
   ../genFreezeTB/spolST.$O \
   ../genLib/ulCp.$O \
   ../genLib/charCp.$O \
   ../genLib/numToStr.$O \
   ../genLib/base10str.$O \
   ../genLib/fileFun.$O

all: closestSpol.$O
	$LD -o closestSpol $objFiles

closestSpol.$O: \
	closestSpol.c \
	../genFreezeTB/findCloseBarcodes.$O \
	../genLib/base10str.$O
		$CC -o closestSpol.$O $CFLAGS closestSpol.c

../genFreezeTB/findCloseBarcodes.$O: \
	../genFreezeTB/findCloseBarcodes.c \
	../genFreezeTB/findCloseBarcodes.h \
	../genFreezeTB/spolST.$O
		$CC -o ../genFreezeTB/findCloseBarcodes.$O \
			$CFLAGS -c ../genFreezeTB/findCloseBarcodes.c

../genFreezeTB/spolST.$O: \
	../genFreezeTB/spolST.c \
	../genFreezeTB/spolST.h \
	../genLib/charCp.$O \
	../genLib/numToStr.$O \
	../genLib/fileFun.$O \
	../genLib/genMath.h \
	../genLib/64bit.h \
	../genFreezeTB/tbSpolDefs.h
		$CC -o ../genFreezeTB/spolST.$O $CFLAGS ../genFreezeTB/spolST.c

../genLib/fileFun.$O: \
	../genLib/fileFun.c \
	../genLib/fileFun.h \
	../genLib/ulCp.$O \
	../genLib/endLine.h
		$CC -o ../genLib/fileFun.$O $CFLAGS ../genLib/fileFun.c

../genLib/ulCp.$O: ../genLib/ulCp.c ../genLib/ulCp.h
		$CC -o ../genLib/ulCp.$O $CFLAGS ../genLib/ulCp.c

../genLib/charCp.$O: ../genLib/charCp.c ../genLib/charCp.h
		$CC -o ../genLib/charCp.$O $CFLAGS ../genLib/charCp.c

../genLib/numToStr.$O: ../genLib/numToStr.c ../genLib/numToStr.h
		$CC -o ../genLib/numToStr.$O $CFLAGS ../genLib/numToStr.c

../genLib/base10str.$O: ../genLib/base10str.c ../genLib/base10str.h
		$CC -o ../genLib/base10str.$O $CFLAGS ../genLib/base10str.c

install:
	mv closestSpol $PREFIX
	chmod a+x $PREFIX/closestSpol
clean:
	rm $objFiles
