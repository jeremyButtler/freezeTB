# This uses the raylib librarys off the raylib github.
#  This should be portable between Linux

CC=cc
LD=cc
MAKE=make
coreCFLAGS=-c -static -O3 -Wall -Wextra
CFLAGS=-DNONE
O=o.linuxAmd64
PREFIX=/usr/local/bin
raylibPath=../raylib-5.5_linux_amd64
RAYFLAGS=\
   $(raylibPath)/lib/libraylib.a \
   -lGL \
   -lm \
   -lpthread \
   -ldl \
   -lrt \
   -lX11

genFreezeTB=../genFreezeTB
genLib=../genLib
genFont=../genFont
genPng=../genPng
genBio=../genBio
genAmr=../genAmr
genAln=../genAln
genClust=../genClust
genGeneoType=../genGeneoType

objFiles=\
   $(genLib)/numToStr.$O \
   $(genLib)/ulCp.$O \
   $(genLib)/base10str.$O \
   $(genLib)/charCp.$O \
   $(genLib)/strAry.$O \
   $(genLib)/genMath.$O \
   $(genLib)/shellSort.$O \
   $(genLib)/ptrAry.$O \
   $(genLib)/fileFun.$O \
   $(genBio)/codonFun.$O \
   $(genBio)/kmerFun.$O \
   $(genBio)/seqST.$O \
   $(genBio)/gzSeqST.$O \
   $(genBio)/samEntry.$O \
   $(genBio)/trimSam.$O \
   $(genBio)/maskPrim.$O \
   $(genBio)/ampDepth.$O \
   $(genBio)/geneCoord.$O \
   $(genBio)/adjCoords.$O \
   $(genBio)/rmHomo.$O \
   $(genBio)/tbCon.$O \
   $(genBio)/edDist.$O \
   $(genAln)/indexToCoord.$O \
   $(genAln)/alnSet.$O \
   $(genAln)/dirMatrix.$O \
   $(genAln)/kmerFind.$O \
   $(genAln)/memwater.$O \
   $(genAln)/memwaterScan.$O \
   $(genAln)/water.$O \
   $(genAln)/needle.$O \
   $(genAln)/mapRead.$O \
   $(genLib)/inflate.$O \
   $(genLib)/checkSum.$O \
   $(genLib)/endin.$O \
   $(genClust)/clustST.$O \
   $(genClust)/edClust.$O \
   $(genFreezeTB)/miruTbl.$O \
   $(genFreezeTB)/spolFind.$O \
   $(genFreezeTB)/spolST.$O \
   $(genFreezeTB)/freezeTBPaths.$O \
   $(genFreezeTB)/freezeTB.$O \
   $(genGeneoType)/linST.$O \
   $(genGeneoType)/getLin.$O \
   $(genFreezeTB)/ftbGraphs.$O \
   $(genFont)/fontST.$O \
   $(genFont)/ibmSan9.$O \
   $(genPng)/mkPng.$O \
   $(genPng)/pngDraw.$O \
   $(genAmr)/checkAmr.$O \
   $(genAmr)/amrST.$O \
   $(genAmr)/drugAry.$O \
   darkLight.$O \
   rayWidg.$O \
   ftbRayST.$O \
   ftbRay.$O

ftbRay: ftbRay.$O
		$(LD) -o ftbRay $(objFiles) $(RAYFLAGS)
	# note, ray lib file should come last. Also, if
	# possible, use local location so the user does not
	# need to install raylib (may not be possible)

ftbRay.$O: \
	ftbRay.c \
	ftbRayST.$O
		$(CC) -I$(raylibPath)/include \
			$(coreCFLAGS) $(CFLAGS) -o ftbRay.$O  ftbRay.c

ftbRayST.$O: \
	ftbRayST.c \
	ftbRayST.h \
	rayWidg.$O \
	$(genFreezeTB)/freezeTB.$O \
	$(genLib)/ptrAry.$O
		$(CC) -I$(raylibPath)/include \
			$(coreCFLAGS) $(CFLAGS) -o ftbRayST.$O ftbRayST.c

$(genLib)/ptrAry.$O: \
	$(genLib)/ptrAry.c \
	$(genLib)/ptrAry.h \
	$(genLib)/ulCp.$O
		$(CC) -o $(genLib)/ptrAry.$O \
			$(CFLAGS) $(coreCFLAGS) \
			$(genLib)/ptrAry.c

rayWidg.$O: \
	rayWidg.c \
	rayWidg.h \
	darkLight.$O \
	$(genLib)/ulCp.$O \
	$(genLib)/base10str.$O \
	$(libRayLib)
		$(CC) -I$(raylibPath)/include \
			$(coreCFLAGS) $(CFLAGS) -o rayWidg.$O rayWidg.c

darkLight.$O: darkLight.h darkLight.c
	$(CC) $(coreCFLAGS) $(CFLAGS) \
		-o darkLight.$O darkLight.c

# need to build raylib, but bit tricky
$(libRayLib): \
	$(raylibPath)/raylib.h
	$(MAKE) \
		PLATFORM=PLATFORM_DESKTOP \
		-C ../raylib/src;
		# need a shared library, because GL is often a
		#  shared library on linux
	#sudo $(MAKE) \
	#	PLATFORM=PLATFORM_DESKTOP \
	#	-C ../raylib/src \
	#	install;

